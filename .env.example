SECRET_KEY=your-secret-key-here-change-this-in-production
DEBUG=True
DB_NAME=business_english_lms
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306


# ── Razorpay Payment Keys (TEST mode) ─────────────────────────────────────────
# Get your test keys from: https://dashboard.razorpay.com/app/keys
# Keys starting with rzp_test_ are safe for development/staging.
# Replace with rzp_live_ keys only in production.
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXX
# PAY-02: webhook signing secret (Razorpay Dashboard → Webhooks). Required for
# the server-side payment webhook. Leave blank to disable the webhook endpoint.
RAZORPAY_WEBHOOK_SECRET=

# ── Email (ZeptoMail SMTP) ─────────────────────────────────────────────────
# Full walkthrough: docs/ZeptoMail_SMTP_Setup.pdf
# ZeptoMail dashboard → Setup → SMTP & API → SMTP tab has every value below.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# smtp.zeptomail.in (or smtp.zeptomail.com for the .com account region)
EMAIL_HOST=smtp.zeptomail.in
# 587 = STARTTLS (pair with EMAIL_USE_TLS=True, EMAIL_USE_SSL=False)
# 465 = implicit SSL (pair with EMAIL_USE_SSL=True, EMAIL_USE_TLS=False)
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# ZeptoMail's SMTP username is always the literal string "emailapikey" —
# it is not your email address.
EMAIL_HOST_USER=emailapikey
# The "Send Mail token" from ZeptoMail → SMTP & API → SMTP tab (click the eye
# icon next to Password to reveal it). Starts with "Zoho-enczapikey ".
EMAIL_HOST_PASSWORD=your-zeptomail-send-mail-token-here
# Must be an address on a domain verified in ZeptoMail (Domains tab).
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ── GST tax invoice (seller details) ───────────────────────────────────────
# Printed on the GST invoice issued for each paid subscription. Fill with the
# supplier's real legal particulars before invoices go to business customers.
GST_RATE=0.18
COMPANY_LEGAL_NAME=Career Buddy Private Limited
COMPANY_GSTIN=29ABCDE1234F1Z5
COMPANY_ADDRESS=Building, Street, City, PIN
COMPANY_STATE=Karnataka
COMPANY_STATE_CODE=29
COMPANY_EMAIL=billing@yourdomain.com
# SAC 999293 = "Commercial training and coaching services".
COMPANY_SAC_CODE=999293

# ── Cache ───────────────────────────────────────────────────────────────────
# OTP codes and rate-limiters are cached. For a MULTI-PROCESS deployment set a
# shared backend so codes/counters are consistent across workers. Leave blank
# for the in-memory default (single-process only).
# Example: CACHE_URL=redis://127.0.0.1:6379/1
CACHE_URL=

# ── MinIO (interview recordings) ───────────────────────────────────────────
# Passing (>= 70) interview recordings are stored in this S3-compatible bucket
# instead of media/interview_videos/. Leave MINIO_ENDPOINT_URL blank to keep
# them on local disk (no MinIO needed for development). In production MinIO
# runs on the same VPS as Django, so the endpoint is the loopback address —
# do not expose port 9000 publicly. MINIO_PUBLIC_URL is the browser-facing URL
# used only to build public video links via the proxy (for example:
# https://careerbuddy4u.com/storage). Keys come from the MinIO console/`mc`
# (Access Keys → Create), not from the hosting provider.
MINIO_ENDPOINT_URL=http://127.0.0.1:9000
MINIO_PUBLIC_URL=https://careerbuddy4u.com/storage
MINIO_ACCESS_KEY=ZYIYR8FT1NKO09DDC3UV
MINIO_SECRET_KEY=xZRcGFrgq0RfqbRFcVDy7O+8g1n8NRVY1Sofc0fg
MINIO_BUCKET=careerbuddy-media
